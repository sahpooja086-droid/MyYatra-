rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function validUserProfile(data) {
      return data.keys().hasOnly([
          'uid', 'fullName', 'displayName', 'email', 'policyAccepted',
          'policyVersion', 'policyAcceptedAt', 'createdAt'
        ])
        && data.keys().hasAll([
          'uid', 'fullName', 'displayName', 'email', 'policyAccepted', 'createdAt'
        ])
        && data.uid is string
        && data.uid == request.auth.uid
        && data.fullName is string
        && data.fullName == data.fullName.trim()
        && data.fullName.size() > 0
        && data.fullName.size() <= 120
        && data.displayName is string
        && data.displayName == data.displayName.trim()
        && data.displayName.size() > 0
        && data.displayName.size() <= 80
        && data.email is string
        && data.email.size() > 0
        && data.email.size() <= 320
        && data.policyAccepted == true;
    }

    function validVisit(data) {
      return data.keys().hasOnly([
          'placeId', 'placeName', 'districtId', 'visitedAt', 'notes', 'rating',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasAll([
          'placeId', 'placeName', 'districtId', 'visitedAt', 'notes', 'rating',
          'createdAt', 'updatedAt'
        ])
        && data.placeId is string
        && data.placeName is string
        && data.placeName.size() <= 120
        && data.districtId is string
        && data.districtId.size() <= 80
        && data.visitedAt is timestamp
        && data.notes is string
        && data.notes.size() <= 2000
        && data.rating is int
        && data.rating >= 1
        && data.rating <= 5
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validJournalEntry(data) {
      return data.keys().hasOnly([
          'title', 'body', 'placeId', 'districtId', 'entryDate', 'createdAt',
          'updatedAt'
        ])
        && data.keys().hasAll([
          'title', 'body', 'placeId', 'districtId', 'entryDate', 'createdAt',
          'updatedAt'
        ])
        && data.title is string
        && data.title == data.title.trim()
        && data.title.size() > 0
        && data.title.size() <= 120
        && data.body is string
        && data.body.size() <= 5000
        && data.placeId is string
        && data.placeId.size() <= 160
        && data.districtId is string
        && data.districtId.size() <= 80
        && data.entryDate is timestamp
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validPhoto(data) {
      return data.keys().hasOnly([
          'downloadUrl', 'storagePath', 'caption', 'placeId', 'districtId',
          'capturedAt', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasAll([
          'downloadUrl', 'storagePath', 'caption', 'placeId', 'districtId',
          'capturedAt', 'createdAt', 'updatedAt'
        ])
        && data.downloadUrl is string
        && data.downloadUrl.matches('^https://[^/\\s]+(/[^\\s]*)?$')
        && data.storagePath is string
        && data.storagePath.size() > 0
        && data.storagePath.size() <= 512
        && data.caption is string
        && data.caption.size() <= 500
        && data.placeId is string
        && data.placeId.size() <= 160
        && data.districtId is string
        && data.districtId.size() <= 80
        && data.capturedAt is timestamp
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validJourneyDna(data) {
      return data.keys().hasOnly(['traits', 'summary', 'updatedAt'])
        && data.keys().hasAll(['traits', 'summary', 'updatedAt'])
        && data.traits is list
        && data.traits.size() <= 12
        && data.traits.hasOnly([
          'Nature', 'Adventure', 'Culture', 'History', 'Food', 'Photography'
        ])
        && data.traits.toSet().size() == data.traits.size()
        && data.summary is string
        && data.summary.size() <= 1000
        && data.updatedAt is timestamp;
    }

    function validReview(reviewId, data) {
      return data.keys().hasOnly([
          'ownerUid', 'displayName', 'targetType', 'targetId', 'rating', 'text',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasAll([
          'ownerUid', 'displayName', 'targetType', 'targetId', 'rating', 'text',
          'createdAt', 'updatedAt'
        ])
        && data.ownerUid is string
        && data.ownerUid == request.auth.uid
        && data.displayName is string
        && data.displayName == data.displayName.trim()
        && data.displayName.size() > 0
        && data.displayName.size() <= 80
        && !data.displayName.matches('.*@.*\\..*')
        && data.targetType in ['place', 'district']
        && data.targetId is string
        && data.targetId.size() > 0
        && data.targetId.size() <= 160
        && data.rating is int
        && data.rating >= 1
        && data.rating <= 5
        && data.text is string
        && data.text == data.text.trim()
        && data.text.size() > 0
        && data.text.size() <= 2000
        && reviewId == request.auth.uid + '--' + data.targetType + '--'
          + data.targetId
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function canonicalDistricts() {
      return {
        'Bhojpur': {'id': 'bhojpur', 'province': 'Koshi'},
        'Dhankuta': {'id': 'dhankuta', 'province': 'Koshi'},
        'Ilam': {'id': 'ilam', 'province': 'Koshi'},
        'Jhapa': {'id': 'jhapa', 'province': 'Koshi'},
        'Khotang': {'id': 'khotang', 'province': 'Koshi'},
        'Morang': {'id': 'morang', 'province': 'Koshi'},
        'Okhaldhunga': {'id': 'okhaldhunga', 'province': 'Koshi'},
        'Panchthar': {'id': 'panchthar', 'province': 'Koshi'},
        'Sankhuwasabha': {'id': 'sankhuwasabha', 'province': 'Koshi'},
        'Solukhumbu': {'id': 'solukhumbu', 'province': 'Koshi'},
        'Sunsari': {'id': 'sunsari', 'province': 'Koshi'},
        'Taplejung': {'id': 'taplejung', 'province': 'Koshi'},
        'Terhathum': {'id': 'terhathum', 'province': 'Koshi'},
        'Udayapur': {'id': 'udayapur', 'province': 'Koshi'},
        'Bara': {'id': 'bara', 'province': 'Madhesh'},
        'Dhanusha': {'id': 'dhanusha', 'province': 'Madhesh'},
        'Mahottari': {'id': 'mahottari', 'province': 'Madhesh'},
        'Parsa': {'id': 'parsa', 'province': 'Madhesh'},
        'Rautahat': {'id': 'rautahat', 'province': 'Madhesh'},
        'Saptari': {'id': 'saptari', 'province': 'Madhesh'},
        'Sarlahi': {'id': 'sarlahi', 'province': 'Madhesh'},
        'Siraha': {'id': 'siraha', 'province': 'Madhesh'},
        'Bhaktapur': {'id': 'bhaktapur', 'province': 'Bagmati'},
        'Chitwan': {'id': 'chitwan', 'province': 'Bagmati'},
        'Dhading': {'id': 'dhading', 'province': 'Bagmati'},
        'Dolakha': {'id': 'dolakha', 'province': 'Bagmati'},
        'Kathmandu': {'id': 'kathmandu', 'province': 'Bagmati'},
        'Kavrepalanchok': {'id': 'kavrepalanchok', 'province': 'Bagmati'},
        'Lalitpur': {'id': 'lalitpur', 'province': 'Bagmati'},
        'Makwanpur': {'id': 'makwanpur', 'province': 'Bagmati'},
        'Nuwakot': {'id': 'nuwakot', 'province': 'Bagmati'},
        'Ramechhap': {'id': 'ramechhap', 'province': 'Bagmati'},
        'Rasuwa': {'id': 'rasuwa', 'province': 'Bagmati'},
        'Sindhuli': {'id': 'sindhuli', 'province': 'Bagmati'},
        'Sindhupalchok': {'id': 'sindhupalchok', 'province': 'Bagmati'},
        'Baglung': {'id': 'baglung', 'province': 'Gandaki'},
        'Gorkha': {'id': 'gorkha', 'province': 'Gandaki'},
        'Kaski': {'id': 'kaski', 'province': 'Gandaki'},
        'Lamjung': {'id': 'lamjung', 'province': 'Gandaki'},
        'Manang': {'id': 'manang', 'province': 'Gandaki'},
        'Mustang': {'id': 'mustang', 'province': 'Gandaki'},
        'Myagdi': {'id': 'myagdi', 'province': 'Gandaki'},
        'Nawalpur': {'id': 'nawalparasi-east', 'province': 'Gandaki'},
        'Parbat': {'id': 'parbat', 'province': 'Gandaki'},
        'Syangja': {'id': 'syangja', 'province': 'Gandaki'},
        'Tanahun': {'id': 'tanahun', 'province': 'Gandaki'},
        'Arghakhanchi': {'id': 'arghakhanchi', 'province': 'Lumbini'},
        'Banke': {'id': 'banke', 'province': 'Lumbini'},
        'Bardiya': {'id': 'bardiya', 'province': 'Lumbini'},
        'Dang': {'id': 'dang', 'province': 'Lumbini'},
        'Gulmi': {'id': 'gulmi', 'province': 'Lumbini'},
        'Kapilvastu': {'id': 'kapilvastu', 'province': 'Lumbini'},
        'Parasi': {'id': 'nawalparasi-west', 'province': 'Lumbini'},
        'Palpa': {'id': 'palpa', 'province': 'Lumbini'},
        'Pyuthan': {'id': 'pyuthan', 'province': 'Lumbini'},
        'Rolpa': {'id': 'rolpa', 'province': 'Lumbini'},
        'Rukum East': {'id': 'rukum-east', 'province': 'Lumbini'},
        'Rupandehi': {'id': 'rupandehi', 'province': 'Lumbini'},
        'Dailekh': {'id': 'dailekh', 'province': 'Karnali'},
        'Dolpa': {'id': 'dolpa', 'province': 'Karnali'},
        'Humla': {'id': 'humla', 'province': 'Karnali'},
        'Jajarkot': {'id': 'jajarkot', 'province': 'Karnali'},
        'Jumla': {'id': 'jumla', 'province': 'Karnali'},
        'Kalikot': {'id': 'kalikot', 'province': 'Karnali'},
        'Mugu': {'id': 'mugu', 'province': 'Karnali'},
        'Rukum West': {'id': 'rukum-west', 'province': 'Karnali'},
        'Salyan': {'id': 'salyan', 'province': 'Karnali'},
        'Surkhet': {'id': 'surkhet', 'province': 'Karnali'},
        'Achham': {'id': 'achham', 'province': 'Sudurpashchim'},
        'Baitadi': {'id': 'baitadi', 'province': 'Sudurpashchim'},
        'Bajhang': {'id': 'bajhang', 'province': 'Sudurpashchim'},
        'Bajura': {'id': 'bajura', 'province': 'Sudurpashchim'},
        'Dadeldhura': {'id': 'dadeldhura', 'province': 'Sudurpashchim'},
        'Darchula': {'id': 'darchula', 'province': 'Sudurpashchim'},
        'Doti': {'id': 'doti', 'province': 'Sudurpashchim'},
        'Kailali': {'id': 'kailali', 'province': 'Sudurpashchim'},
        'Kanchanpur': {'id': 'kanchanpur', 'province': 'Sudurpashchim'}
      };
    }

    // Perform the 77-entry lookup once per authorized write. Keeping identity
    // validation in this single helper avoids repeatedly evaluating the large
    // canonical map against Firestore's rules expression budget.
    function isCanonicalDistrict(districtId, data) {
      let expected = canonicalDistricts().get(data.get('name', ''), {});
      return expected.keys().hasAll(['id', 'province'])
        && expected.get('id', '') == districtId
        && expected.get('province', '') == data.get('province', '');
    }

    function validDistrictData(data) {
      return data.keys().hasOnly([
          'name', 'province', 'description', 'experienceTypes', 'updatedAt'
        ])
        && data.keys().hasAll([
          'name', 'province', 'description', 'experienceTypes', 'updatedAt'
        ])
        && data.name is string
        && data.province is string
        && data.description is string
        && data.description.size() > 0
        && data.description.size() <= 2000
        && data.description.matches('.*\\S.*')
        && data.experienceTypes is list
        && data.experienceTypes.size() > 0
        && data.experienceTypes.size() <= 6
        && data.experienceTypes.hasOnly([
          'Nature', 'Adventure', 'Culture', 'History', 'Food', 'Photography'
        ])
        && data.experienceTypes.toSet().size() == data.experienceTypes.size()
        && data.updatedAt is timestamp;
    }

    function canonicalPlaceId(placeId, data) {
      let name = data.get('name', '');
      let districtId = data.get('districtId', '');
      let slug = name.lower()
        .replace('[^a-z0-9]+', '-')
        .replace('^-+|-+$', '');
      return name is string
        && districtId is string
        && slug.size() > 0
        && placeId == districtId + '--' + slug;
    }

    function isCanonicalDistrictReference(districtId) {
      let districtPath = /databases/$(database)/documents/districts/$(districtId);
      return existsAfter(districtPath)
        && isCanonicalDistrict(districtId, getAfter(districtPath).data);
    }

    function placeIndexReady() {
      // A trusted emulator initializer accounts for records predating the rules.
      return exists(/databases/$(database)/documents/internal/placeReferenceIndex);
    }

    function placeCount(districtId) {
      let path = /databases/$(database)/documents/districtPlaceCounts/$(districtId);
      return exists(path) ? get(path).data.count : 0;
    }

    function changesPlaceCount(districtId, placeId, delta) {
      // The ID pairs one Place mutation with one count change for this district.
      let path = /databases/$(database)/documents/districtPlaceCounts/$(districtId);
      let next = getAfter(path).data;
      return placeIndexReady()
        && next.placeId == placeId
        && next.count == placeCount(districtId) + delta;
    }

    function validPlaceCountWrite(districtId) {
      let next = request.resource.data;
      let path = /databases/$(database)/documents/places/$(next.placeId);
      let before = placeCount(districtId);
      return placeIndexReady()
        && next.keys().hasOnly(['count', 'placeId'])
        && next.count is int && next.count >= 0
        && next.placeId is string
        && ((next.count == before + 1
            && !exists(path) && existsAfter(path)
            && getAfter(path).data.districtId == districtId)
          || (next.count == before - 1
            && exists(path) && !existsAfter(path)
            && get(path).data.districtId == districtId));
    }

    function validPlaceData(placeId, data) {
      return data.keys().hasOnly([
          'name', 'category', 'districtId', 'description', 'imageUrl',
          'updatedAt'
        ])
        && data.keys().hasAll([
          'name', 'category', 'districtId', 'description', 'updatedAt'
        ])
        && data.name is string
        && data.name == data.name.trim()
        && data.name.size() > 0
        && data.name.size() <= 120
        && data.category is string
        && data.category == data.category.trim()
        && data.category.size() > 0
        && data.category.size() <= 80
        && data.districtId is string
        && data.description is string
        && data.description == data.description.trim()
        && data.description.size() > 0
        && data.description.size() <= 2000
        && data.updatedAt is timestamp
        && (!data.keys().hasAny(['imageUrl'])
          || (data.imageUrl is string
            && data.imageUrl == data.imageUrl.trim()
            && data.imageUrl.size() > 0
            && data.imageUrl.size() <= 2048
            && data.imageUrl.matches('^https://[^/\\s]+(/[^\\s]*)?$')))
        && canonicalPlaceId(placeId, data);
    }

    match /districts/{districtId} {
      // District documents contain public travel information only. Firestore
      // rules cannot redact individual fields from a returned document.
      allow read: if true;

      allow create: if isAdmin()
        && validDistrictData(request.resource.data)
        && isCanonicalDistrict(districtId, request.resource.data);

      // Keep the document ID and canonical district identity unchanged.
      allow update: if isAdmin()
        && validDistrictData(request.resource.data)
        && isCanonicalDistrict(districtId, request.resource.data)
        && request.resource.data.name == resource.data.name
        && request.resource.data.province == resource.data.province;

      // Admins may delete only records with a canonical document ID and
      // matching identity and valid district fields. Legacy/malformed records
      // need review.
      allow delete: if isAdmin()
        && validDistrictData(resource.data)
        && isCanonicalDistrict(districtId, resource.data)
        && placeIndexReady()
        && placeCount(districtId) == 0;
    }

    match /districtPlaceCounts/{districtId} {
      allow get: if isAdmin();
      allow create, update: if isAdmin() && validPlaceCountWrite(districtId);
    }

    match /internal/placeReferenceIndex {
      allow get: if isAdmin();
    }

    match /places/{placeId} {
      // Place records contain public travel information only.
      allow read: if true;

      allow create: if isAdmin()
        && validPlaceData(placeId, request.resource.data)
        && isCanonicalDistrictReference(request.resource.data.districtId)
        && changesPlaceCount(request.resource.data.districtId, placeId, 1);

      // Place identity and district association are stable after creation.
      allow update: if isAdmin()
        && validPlaceData(placeId, request.resource.data)
        && isCanonicalDistrictReference(request.resource.data.districtId)
        && request.resource.data.name == resource.data.name
        && request.resource.data.districtId == resource.data.districtId;

      // Malformed/legacy records remain readable but require review before
      // deletion.
      allow delete: if isAdmin()
        && validPlaceData(placeId, resource.data)
        && isCanonicalDistrictReference(resource.data.districtId)
        && changesPlaceCount(resource.data.districtId, placeId, -1);
    }

    // Account profiles are private. Only the owner can read or write them.
    match /users/{uid} {
      allow get, list: if isOwner(uid);
      allow create: if isOwner(uid) && validUserProfile(request.resource.data);
      allow update: if isOwner(uid)
        && validUserProfile(request.resource.data)
        && request.resource.data.uid == resource.data.uid;
      allow delete: if false;
    }

    // Personal travel records live under the owner's account document, so no
    // other user has a readable path to them.
    match /users/{uid}/visits/{visitId} {
      allow get, list: if isOwner(uid);
      allow create, update: if isOwner(uid) && validVisit(request.resource.data);
      allow delete: if isOwner(uid);
    }

    match /users/{uid}/journalEntries/{entryId} {
      allow get, list: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && validJournalEntry(request.resource.data);
      allow delete: if isOwner(uid);
    }

    match /users/{uid}/photos/{photoId} {
      allow get, list: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && validPhoto(request.resource.data)
        && request.resource.data.storagePath.matches(
          '^users/' + uid + '/photos/[^/\\s]+$'
        );
      allow delete: if isOwner(uid);
    }

    match /users/{uid}/journeyDna/{documentId} {
      allow get, list: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && validJourneyDna(request.resource.data);
      allow delete: if isOwner(uid);
    }

    // Reviews are public, but only the display name is exposed alongside the
    // review content. Email addresses are rejected by validReview().
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && validReview(reviewId, request.resource.data);
      allow update: if isSignedIn()
        && request.auth.uid == resource.data.ownerUid
        && validReview(reviewId, request.resource.data);
      allow delete: if isSignedIn()
        && request.auth.uid == resource.data.ownerUid;
    }

    // No rules are granted for any other collection or document.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
